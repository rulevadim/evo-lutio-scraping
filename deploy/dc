#!/usr/bin/env bash
# Обёртка над docker compose для ручных команд на сервере.
#
# Голый `docker compose ps` в /srv/evo не работает: файл требует IMAGE_REF,
# а он лежит в отдельном image.env (текущий тег хранится не вместе с секретами).
# Обёртка подставляет оба env-файла, поэтому ведёт себя ровно как деплой.
#
#   ./dc ps
#   ./dc logs -f app
#   ./dc restart app
set -euo pipefail
cd "$(dirname "$0")"
exec docker compose --env-file ./.env --env-file ./image.env "$@"
