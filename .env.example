# Скопируйте в .env (он в .gitignore) и задайте свои значения.
# Без этих переменных сайт работает в режиме «только чтение»: список, страница
# поста и поиск доступны, а скрейпинг закрыт — кнопок нет, эндпоинты отдают 401.

# Пароль входа в админку (/admin).
NUXT_ADMIN_PASSWORD=

# Ключ подписи сессионной куки: не меньше 32 символов и криптослучайный.
# Сгенерировать:  openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Путь к файлу БД. Локально не нужен (по умолчанию .data/blog.db),
# в контейнере задаётся на примонтированный том.
# DB_PATH=/data/blog.db
